PUBLIC_SITE_ORIGIN=http://localhost:8787
PUBLIC_ASSET_ORIGIN=http://localhost:8787/file
IMAGE_API_BASE_URL=https://image-host.example.invalid
DEFAULT_UPLOAD_FOLDER=uploads
PAGES_PROJECT_NAME=myblogweb-cloudflarepage
