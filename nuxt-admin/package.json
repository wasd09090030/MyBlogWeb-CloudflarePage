{
  "name": "myblog-nuxt-admin",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "db:export": "node scripts/sqlite-d1-export.mjs",
    "db:import": "node scripts/sqlite-d1-import.mjs --config wrangler.toml",
    "db:verify": "node scripts/sqlite-d1-verify.mjs",
    "db:migrate:local": "wrangler d1 migrations apply blog-db --local --config wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply blog-db --remote --config wrangler.toml",
    "deploy:worker": "npm run build && wrangler deploy --config wrangler.toml",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/mdc": "^0.19.2",
    "@tailwindcss/vite": "^4.3.3",
    "katex": "^0.16.47",
    "mermaid": "^11.16.0",
    "nuxt": "^4.3.0",
    "valibot": "^1.4.2",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@iconify-json/lucide": "^1.2.119",
    "@types/node": "^24.0.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.118.0"
  }
}
